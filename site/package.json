{
  "name": "typenext-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The TypeNext project website (GitHub Pages).",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets": "node scripts/sync-assets.mjs",
    "predev": "npm run assets",

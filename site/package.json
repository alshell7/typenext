    "typecheck": "tsc --noEmit",
    "reactbits": "node scripts/add-reactbits.mjs"
  },
  "dependencies": {
    "@fontsource/merriweather": "5.2.11",
    "@fontsource/source-sans-pro": "5.2.5",
    "motion": "12.43.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "vite": "7.3.6"
  }
}
